<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSettingsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your Smart Pantry Manager"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APP INFORMATION"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage pantry ingredients, reduce food waste and discover recipes using the ingredients you already have."
                android:textSize="15sp"
                android:textColor="#666666"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANTRY MANAGEMENT"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR ALL PANTRY ITEMS"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828"
            android:minHeight="52dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBackToPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK TO PANTRY"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:minHeight="52dp" />

    </LinearLayout>

</ScrollView>