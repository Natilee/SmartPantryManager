<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0"
    android:padding="16dp">

    <!-- TITLE -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use what you have. Waste less."
        android:textSize="15sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="16dp" />


    <!-- MY PANTRY SECTION BUTTON -->

    <Button
        android:id="@+id/btnPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MY PANTRY"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:minHeight="48dp"
        android:layout_marginBottom="10dp" />


    <!-- PANTRY LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical"
        android:overScrollMode="always"
        android:nestedScrollingEnabled="false"
        android:focusable="true"
        android:clickable="true" />


    <!-- ADD INGREDIENT -->

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+  ADD INGREDIENT"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />


    <!-- SUGGESTED RECIPES -->

    <Button
        android:id="@+id/btnSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUGGESTED RECIPES"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F57C00"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp" />


    <!-- SETTINGS -->

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SETTINGS"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#616161"
        android:minHeight="48dp" />

</LinearLayout>