<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use what you have. Waste less."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnPantryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY PANTRY  ▼"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:minHeight="52dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/pantryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvEmptyPantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your pantry is currently empty.

Add your first ingredient to start building your pantry and discovering recipes."
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:padding="24dp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPantry"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:nestedScrollingEnabled="true" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  ADD INGREDIENT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:minHeight="50dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUGGESTED RECIPES"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57C00"
            android:minHeight="50dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:minHeight="50dp"
            android:backgroundTint="#616161" />

    </LinearLayout>

</ScrollView>